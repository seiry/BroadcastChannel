{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-05-31",
  "keep_vars": true,
  "build": {
    "command": "pnpm build:worker"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ]
}
